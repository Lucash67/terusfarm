# WhatsApp no formato internacional, sem + ou espaços.
NEXT_PUBLIC_WHATSAPP_NUMBER=558596290044

# Mensagens opcionais (senão usa o padrão em src/config/contact.ts)
NEXT_PUBLIC_WHATSAPP_MESSAGE=
NEXT_PUBLIC_WHATSAPP_DEMO_MESSAGE=

# URL de agendamento. Se vazio, o CTA de demo usa WhatsApp.
NEXT_PUBLIC_DEMO_URL=

# Raio-X: endpoint de captura (padrão /api/diagnostic neste repo).
NEXT_PUBLIC_DIAGNOSTIC_ENDPOINT=/api/diagnostic

# Webhook server-side (Make/Zapier/CRM). Só roda no servidor — não expor no client.
# DIAGNOSTIC_WEBHOOK_URL=https://hook.us1.make.com/xxxxxxxx

# Stats Aquafarm: false até autorização comercial explícita.
NEXT_PUBLIC_SHOW_AQUAFARM_STATS=true

# Desliga motion em desenvolvimento: false
NEXT_PUBLIC_ENABLE_MOTION=true
